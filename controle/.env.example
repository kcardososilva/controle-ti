# Modelo do .env — copie este arquivo para ".env" (na mesma pasta, controle/) e preencha.
# NUNCA coloque valor real aqui nem versione o ".env". O servidor só lê o .env na
# PARTIDA: depois de mudar qualquer chave, pare e suba o servidor de novo (o
# autoreload do runserver não relê o arquivo).
#
# Regra deste modelo: chave sem valor padrão no código fica ATIVA e vazia (preencha);
# chave que já tem padrão no settings.py fica COMENTADA com o padrão — descomente só
# se precisar mudar. Deixar uma chave com padrão ativa e vazia a SOBRESCREVE com
# texto vazio (ex.: EMAIL_PORT= vazio derruba o sistema na partida).

# ── Django: o básico ─────────────────────────────────────────────────────────
# Obrigatória: sem ela o sistema nem sobe. Gerar:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Em produção, SEMPRE False (True expõe rastreio de erro e desliga proteções).
DJANGO_DEBUG=False
# Hosts aceitos, separados por vírgula. Em produção inclua o IP interno do servidor
# e o domínio externo; sem isso o Django responde erro 400.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Caminho do banco SQLite. Vazio = controle/db.sqlite3. Em pasta sincronizada pelo
# OneDrive aponte para um caminho LOCAL, fora dele (o SQLite trava com o sincronismo).
DJANGO_DB_PATH=
# Pasta dos logs (erros.log, seguranca.log). Vazio = controle/logs. Prefira fora do OneDrive.
DJANGO_LOG_DIR=

# ── Transporte e sessão (ver CLAUDE.md, regra 28, ANTES de ligar o HTTPS) ────
# True SÓ quando o domínio externo tiver certificado: ligado sem TLS, ninguém entra.
# DJANGO_HTTPS=False
# Duração do HSTS em segundos (só vale com DJANGO_HTTPS=True). Comece curto: é irreversível.
# DJANGO_HSTS_SECONDS=3600
# Origens confiáveis para POST, separadas por vírgula. Vazio = derivadas de DJANGO_ALLOWED_HOSTS.
# DJANGO_CSRF_TRUSTED_ORIGINS=
# Duração da sessão, em horas (janela deslizante).
# DJANGO_SESSION_HORAS=12
# Validade do link de "esqueci minha senha", em horas.
# DJANGO_RESET_TIMEOUT_HORAS=2

# ── E-mail (envio por SMTP) ──────────────────────────────────────────────────
EMAIL_HOST=smtp.outlook.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Conta que envia. Também é a caixa que recebe as respostas dos chamados (CHAMADOS_CAIXA).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remetente das mensagens automáticas. Vazio no código = EMAIL_HOST_USER.
# DEFAULT_FROM_EMAIL=nao-responda@exemplo.com.br
# Lista padrão dos alertas por e-mail (a Central de Alertas pode definir listas por canal).
ALERTA_EMAIL=
# Mais destinatários, separados por vírgula (opcional).
ALERTA_EMAILS=
# Quem recebe os avisos de manutenção (fornecedor/TI), separados por vírgula.
# O padrão do código é um endereço de teste: defina em produção.
# TI_EMAILS=ti@exemplo.com.br
# Endereço pelo qual a TI e o RH abrem o sistema (sem barra no fim), para o link dos
# e-mails. Vazio = e-mail sem link.
SISTEMA_URL=

# ── Chamados de contratação: ler as respostas por e-mail (Microsoft Graph) ───
# As três chaves vazias = sincronização DESLIGADA (o envio por SMTP segue funcionando).
# Passo a passo: docs/TUTORIAL_CHAMADOS_CONVERSA.md.
CHAMADOS_GRAPH_TENANT_ID=
CHAMADOS_GRAPH_CLIENT_ID=
CHAMADOS_GRAPH_CLIENT_SECRET=
# Caixa que recebe as respostas. Vazio = EMAIL_HOST_USER.
CHAMADOS_CAIXA=
# Pasta dos anexos e e-mails brutos dos chamados. Vazio = controle/chamados_arquivos.
# Em produção aponte para uma pasta que ENTRE NO BACKUP.
CHAMADOS_ARQUIVOS_DIR=

# ── Quiosque (app Android) ───────────────────────────────────────────────────
# Pasta do instalador (.apk). Vazio = controle/kiosk_apk.
KIOSK_APK_DIR=

# ── PRTG (monitoramento de rede) ─────────────────────────────────────────────
# As credenciais ficam só no servidor e nunca chegam ao navegador.
PRTG_URL=
PRTG_USER=
PRTG_PASSHASH=

# ── NinjaOne RMM (OAuth2, app tipo "Web" — a conexão é feita uma vez, em /ninja/) ─
NINJA_BASE_URL=
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=
# Chave Fernet que cifra o token salvo no banco. Sem ela a tela recusa conectar.
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NINJA_CHAVE_CIFRA=
# Tem de ser IGUAL à URI cadastrada no aplicativo OAuth do NinjaOne. O padrão do código
# aponta para o endereço externo atual; só defina se ele mudar.
# NINJA_REDIRECT_URI=https://seu-dominio.exemplo/ninja/oauth/callback/
# Escopos pedidos. Padrão "monitoring offline_access" (offline_access = refresh token).
# Se o NinjaOne recusar com invalid_scope, use apenas: NINJA_SCOPES=monitoring
# NINJA_SCOPES=monitoring offline_access

# ── Conectividade: API do GSIM (Saitro), plataforma de SIM Cards da TIM ──────────
# Documentação (pede login): https://tim.saitro.com/api/docs/ — a API só atende IPs que a
# Saitro liberou, inclusive o do servidor de produção (peça a liberação ANTES de ligar).
# Raiz da API (https obrigatório; é a ÚNICA fonte do endereço, nenhuma tela aceita URL).
# Vazio = https://tim.saitro.com/api
# TIM_M2M_BASE_URL=https://tim.saitro.com/api
# Usuário e senha da API: trocados por um token de acesso (OAuth2, vale 2 h) a cada necessidade.
TIM_M2M_CLIENT_ID=
TIM_M2M_CLIENT_SECRET=
# Opcional, para quem já tem um Bearer pronto. Só vale SEM usuário e senha acima; VENCE o token
# salvo (cifrado) na tela de Configuração.
TIM_M2M_TOKEN=
# Chave Fernet que cifra o token guardado no banco (só o token estático). Sem ela a tela recusa gravar.
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde a chave fora do banco e do backup do banco: trocá-la torna o token salvo ilegível.
TIM_M2M_CHAVE_CIFRA=
